+      return preview;
+    },
+    validate: async entry => {
+      const p = entry.preview;
+      if (!p?.data?.approvalToken || !Number.isFinite(p.expiresAt) || Date.now() >= p.expiresAt) throw fail('Anteprima scaduta: rigenera e approva di nuovo.', 'APPROVAL_EXPIRED');
